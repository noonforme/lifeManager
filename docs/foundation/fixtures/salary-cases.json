{
  "schema_version": 1,
  "description": "Portable salary characterization cases. All intermediate values use exact decimal arithmetic. Only documented outputs are rounded with ROUND_HALF_UP to two decimal places.",
  "rounding": {
    "mode": "ROUND_HALF_UP",
    "output_places": 2
  },
  "cases": [
    {
      "id": "ordinary-month",
      "shifts": [{"type": "normal", "hours": "160.00", "overtime_hours": "10.00", "hourly_rate": "10.00"}],
      "expected_normal_hours": "150.00",
      "expected_mean_rate": "10.00",
      "expected_gross": "1650.00",
      "expected_gpm": "330.00",
      "expected_vsd": "206.58",
      "expected_psd": "115.17",
      "expected_total_taxes": "651.75",
      "expected_net": "998.25"
    },
    {
