  "narrative": {
    "northStar": "The 2001 Office PC",
    "overview": "LifeOS looks and behaves like a friendly, glossy office PC from around 2001, shaped like that era's file browser: orb toolbar, Address bar, blue task pane, details lists, property sheets and a sunken status bar. It is the only style.",
    "keyCharacteristics": [
      "Face chrome, white lists, blue heads and selection.",
      "Bevels and gradients are the only depth; no drop shadows.",
      "Noto Sans with tabular figures.",
      "Every derived figure explains itself in the Working group box; every record has a History."
    ],
    "rules": [
      {
        "name": "The Words-First Rule",
        "body": "States and over/under are always written; colour only supports the word.",
        "section": "colors"
      },
      {
        "name": "The No-Vendor Rule",
        "body": "No vendor names, logos, icons, wallpapers or sounds; glyphs are painted.",
        "section": "colors"
      },
      {
        "name": "The Era Rule",
        "body": "Every design choice mimics the 2001 desktop era.",
        "section": "overview"
      }
    ],
    "dos": [
      "Choose the era-authentic control.",
      "Explain every derived figure in Working.",
      "Take colours only from tokens and MillenniumColors.",
      "Keep targets at least 24 × 24 and focus distinct from selection.",
      "Paint glyphs the bundled font lacks."
    ],
    "donts": [
      "Add a second palette, dark mode or appearance setting.",
      "Use vendor names, logos, icons, wallpapers or sounds.",
      "Add drop shadows or blur.",
      "Signal state by colour alone."
    ]
  }
